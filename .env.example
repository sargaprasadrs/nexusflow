# MongoDB Atlas connection string. Keep this file local and never commit a real URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/nexusflow?retryWrites=true&w=majority
MONGODB_DB=nexusflow

# Standalone app server configuration.
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Required to use POST /api/seed. Use a long random value in your real .env file.
NEXUSFLOW_SEED_TOKEN=replace-with-a-long-random-secret

# Used only by the Vite development server. Omit it when serving the built app through server.mjs.
VITE_API_BASE_URL=http://localhost:3001