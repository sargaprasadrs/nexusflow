# NexusFlow backend environment variables
# Copy to .env and adjust for your machine. Never commit .env.

PORT=4000
MONGODB_URI=mongodb://localhost:27017/nexusflow
NODE_ENV=development

# CORS origin for the frontend dev server
CLIENT_ORIGIN=http://localhost:5173

# Webhook signing secret (Week 3) - generate one, e.g. `openssl rand -hex 32`
WEBHOOK_SECRET=
